{
  "name": "recipe-art-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --noEmit && vite build",
    "check": "npm run format:check && tsc --noEmit && node scripts/build.mjs --check",
    "clean:generated": "node scripts/clean-generated.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.config.ts index.html tsconfig.json components.json package.json",
    "format:check": "prettier --check src tests scripts/*.mjs *.config.ts index.html tsconfig.json components.json package.json",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "nutrition:sync": "node --env-file-if-exists=.env.local scripts/nutrition-sync.mjs",
    "nutrition:ingredients": "node --env-file-if-exists=.env.local scripts/nutrition-ingredients.mjs",
    "nutrition:prepare": "node scripts/nutrition-prepare-batches.mjs",
    "nutrition:apply": "node scripts/nutrition-plans.mjs",
    "nutrition:review": "node scripts/nutrition-review.mjs",
    "nutrition:compress": "node scripts/nutrition-compress.mjs",
    "nutrition:changes": "node scripts/nutrition-changes.mjs",
    "nutrition:verify": "node scripts/verify-nutrition.mjs",
    "usda": "node --env-file-if-exists=.env.local scripts/usda.mjs",
    "dev": "node scripts/build.mjs && vite",
    "preview": "node scripts/serve.mjs --dist"
  },
  "description": "独立的Q版菜谱插画图鉴、透明WebP与公开JSON目录",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pinyin-pro": "^3.29.5",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
