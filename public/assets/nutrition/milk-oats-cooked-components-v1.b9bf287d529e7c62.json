      "excludes": [
        "原文40g干燕麦与280ml牛奶的精确换算",
        "微波后继续失水、额外煎蛋油或椒盐水果饼干",
        "燕麦麸、甜味即食燕麦、脱脂奶、植物奶或其他奶脂含量"
      ]
    },
    "assumptions": [
      "常见早餐标准量直接以熟重定义：熟燕麦200g、牛奶280g、熟煎蛋50g，原菜谱份量不确定处采用显式独立标准，不冒充原文测量。",
      "只选择清水煮燕麦后搭配牛奶的分支，采用USDA无盐清水熟燕麦的成品含水量；不从40g干燕麦加200ml煮水求成品。",
      "牛奶直接称280g，明确3.25%脂肪全脂牛奶，不使用无密度依据的ml换g。",
      "鸡蛋使用USDA煎熟全蛋通用参考、按去壳熟重50g；烹调脂肪已在熟蛋条目内，不将其当生蛋并漏油，也不重复加油。",
      "全部成分完成烹饪并放温后定义熟重，只汇总这些可食成分，之后不再微波、沥水或丢弃；可分开食用。",
      "可选椒盐、水果蔬菜及饼干不包括在本标准配方；额外油、糖、酱料均不包括。"
    ],
    "uncertainty": [
      "熟燕麦含水量与USDA参考不同会改变每100g结果；200g是独立标准熟重，不能反推原文40g干料出成率。",
      "煎蛋条目已反映USDA通用烹调脂肪，但实际锅中加油量、吸收量和残油不一定相同；不是某次用油的精确估算。",
      "全脂奶实际奶脂和蛋大小会有差异；没有额外施加热加工损失校正，改用原料重或继续加热时应另算。"
    ],
    "process": {
      "retention_correction": "not_applied",
      "no_heating_after_weighing": true,
      "all_edible_material_retained": true,
      "preparation_before_weighing": "燕麦和鸡蛋已分别烹熟并放温，按成品可食量定义；使用熟食来源，不声称原料营养全部保留。"
    },
    "final_weight": {
